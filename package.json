{
  "name": "@cosmintrica/culinary-assets",
  "version": "0.4.0",
  "description": "130 transparent culinary illustrations: individual PNG/WebP and optional WebP sprites. CC0 artwork, MIT code.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "default": "./dist/native.cjs"
    },
    "./sprite": {
      "types": "./dist/sprite.d.ts",
      "default": "./dist/sprite.js"
    },
    "./sprite/*.webp": "./assets/sprite/*.webp",
    "./sprite/atlas.json": "./assets/sprite/atlas.json",
    "./catalog.json": "./catalog.json",
    "./png/*.png": "./assets/png/*.png",
    "./webp/*.webp": "./assets/webp/*.webp",
    "./package.json": "./package.json"
  },
  "files": [
    "assets",
    "dist",
    "catalog.json",
    "LICENSE",
    "LICENSE-ASSETS",
    "LICENSE-CODE",
    "LICENSES",
    "NOTICE.md",
    "SECURITY.md"
  ],
  "sideEffects": false,
  "license": "(CC0-1.0 AND MIT)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosmintrica/culinary-assets.git"
  },
  "bugs": {
    "url": "https://github.com/cosmintrica/culinary-assets/issues"
  },
  "homepage": "https://cosmintrica.github.io/culinary-assets/",
  "author": "cosmintrica",
  "keywords": [
    "culinary",
    "food",
    "ingredients",
    "kitchen",
    "png",
    "webp",
    "cc0",
    "expo",
    "react-native"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "sharp": "0.35.4"
  }
}
